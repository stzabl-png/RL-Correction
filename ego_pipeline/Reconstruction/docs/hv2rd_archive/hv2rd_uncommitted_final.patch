-    if wrt == "uv":
-        c = abc[..., 2][..., None, None, None]
-        return -c * torch.eye(2, device=uv.device, dtype=uv.dtype).expand(uv.shape[:-1] + (2, 2))
-
-    elif wrt == "abc":
