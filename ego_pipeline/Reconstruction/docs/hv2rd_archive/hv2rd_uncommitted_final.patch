-
-    def resize(self, size: tuple[int, int]) -> "VideoFrame":
-        """
-        Resize the frame to a given size.
-        """
-        h0, w0 = self.size()
-        h1, w1 = size
-
-        new_rgb = (
-            torch.nn.functional.interpolate(self.rgb.permute(2, 0, 1)[None], size, mode="bilinear")
-            .squeeze(0)
