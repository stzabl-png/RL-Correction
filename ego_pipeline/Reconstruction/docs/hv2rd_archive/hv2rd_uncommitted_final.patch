-        y2s[tid] = coords[b][m][h1][w1][1] / coord_scale;
-    } else {
-        x2s[tid] = 0.0f;
-        y2s[tid] = 0.0f;
-    }
-
-    const float x2 = x2s[tid];
-    const float y2 = y2s[tid];
-    const float dx = x2 - floorf(x2);
-    const float dy = y2 - floorf(y2);
-    const int rd = 2 * r + 1;
