-    def _resize_longest_side(self, img: Image.Image, target_size: int) -> Image.Image:
-        w, h = img.size
-        longest = max(w, h)
-        if longest == target_size:
-            return img
-        scale = target_size / float(longest)
-        new_w = max(1, int(round(w * scale)))
-        new_h = max(1, int(round(h * scale)))
