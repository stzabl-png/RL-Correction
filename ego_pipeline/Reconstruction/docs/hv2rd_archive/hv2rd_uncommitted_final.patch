-    x_0 = 1
-    x_1 = 0
-
-    det = a_00 * a_11 - a_01 * a_01
-
-    if det != 0:
-        x_0 = (a_11 * b_0 - a_01 * b_1) / det
-        x_1 = (-a_01 * b_0 + a_00 * b_1) / det
