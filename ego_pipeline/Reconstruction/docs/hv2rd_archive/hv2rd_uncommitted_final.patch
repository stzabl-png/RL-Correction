-            Jf[..., 1, 0] = v_bar * f_num / f_denom
-
-            k_num = (k1 + q) * (k1 * r2 + q * (r2 + 1) - q) - (k1 * r2 - q) * (-k1 * (r2 + 1) + k1 + q)
