-    def _resize_ixt(
-        self,
-        intrinsic: np.ndarray | None,
-        orig_w: int,
-        orig_h: int,
-        w: int,
-        h: int,
-    ) -> np.ndarray | None:
-        if intrinsic is None:
-            return None
-        K = intrinsic.copy()
-        # scale fx, cx by w ratio; fy, cy by h ratio
-        K[:1] *= w / float(orig_w)
-        K[1:2] *= h / float(orig_h)
