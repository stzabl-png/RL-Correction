-            except ModuleNotFoundError as exc:
-                raise ModuleNotFoundError(
-                    "huggingface_hub is required to fetch DAP weights. "
-                    "Install it with `pip install huggingface_hub` or pass "
-                    "`weights_path=...` explicitly."
