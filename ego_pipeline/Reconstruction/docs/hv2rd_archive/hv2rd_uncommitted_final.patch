-                    fx * (-k1 * X**2 + rbase * r) / r_denom,
-                    -fx * k1 * X * Y / r_denom,
-                    -fx * X * (k1 * Z + r) / r_denom,
-                    o,
-                    -fy * k1 * X * Y / r_denom,
-                    fy * (-k1 * Y**2 + rbase * r) / r_denom,
-                    -fy * Y * (k1 * Z + r) / r_denom,
-                    o,
-                ],
-                dim=-1,
-            ).view(N, *extra_dim_shapes, 2, 4)
