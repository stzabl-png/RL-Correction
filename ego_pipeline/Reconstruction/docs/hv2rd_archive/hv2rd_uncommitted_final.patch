-        t = self.video.n_frames
-
-        graph = FactorGraph(
-            self.net,
-            self.video,
-            self.device,
-            max_factors=16 * t,
-            incremental=False,
-            cross_view=self.args.cross_view,
-        )
-
-        graph.add_proximity_factors(
-            rad=self.args.backend_radius,
-            nms=self.args.backend_nms,
-            thresh=self.args.backend_thresh,
-            beta=self.args.beta,
