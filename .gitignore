# ---- 训练/运行产物 ----
logs/
# results/ 整体不入库, 但**冠军存档**例外 —— 让外部协作者能完整复现一条成功训练。
# 例外目录用 `git add -f` 强制跟踪 (已跟踪的文件不再受 ignore 约束), 见
# results/part2/basic_pick_place/3/Approach_Pick_冠军seed42/README.md
results/
wandb/
outputs/
# 例外: 自带最小数据集里的 affordance 产物 (路径必须保持 AFFORDANCE_ROOT/outputs/... 的形状)
!datasets/AffordanceModel/outputs/
runs/
__pycache__/
*.egg-info/
.hydra/
*.pyc

# ---- 数据 (体积大, 由上游流水线生成, 不入库) ----
# TrainingData: stage_training_data.py 从 OCIR/Bi-V2AP 归置的四类源数据 (~100MB+)
TrainingData/
# data/: 消融曲线 npz、ocir 缓存等生成物
data/
# 物体 USD / retarget 缓存 (由 mesh 自动转换生成)
**/cache/object.usd
**/cache/human_fq_*.npz

# ---- 派生资产 ----
# 2026-08-03: `assets/*.usd` **改为入库** (走 LFS). 原来不入库、让每台机器自己跑
#   tools/ 脚本重建, 结果是同事 clone 后机器人散架 —— 因为重建依赖 MagicSim 那边的
#   资产布局, 而那个布局各机器不一样 (见 tools/make_fixed_torso_usd.py 里的注释).
#   25MB 走 LFS 完全扛得住, 比"每人重建一次"可靠. 重建配方仍在 docs/DEPLOY_NEW_MACHINE.md.
assets/*.usd.bak
*.bak_local

# ---- 查看器运行时状态 ----
.env_viewer.json
.env_viewer.log

# ---- 媒体产物 ----
videos_compare/
*.mp4
*.avi

# ---- 杂项 ----
.DS_Store
*.swp
.vscode/
.idea/

# ---- 旧 SharpaWave 手内旋转栈的产物 (与 RL_Correction 无关, 本地保留但不入库) ----
checkpoints/
cache/
media/
*.pth

# ---- 本机 Claude Code 配置 ----
.claude/settings.local.json
