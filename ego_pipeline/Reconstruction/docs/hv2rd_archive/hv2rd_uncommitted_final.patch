-def _median_nn_thresh(pose_ref, pose_est_aligned):
-    P_ref = pose_ref[:, :3, 3]
-    P_est = pose_est_aligned[:, :3, 3]
-    dists = []
-    for p in P_est:
-        dd = np.linalg.norm(P_ref - p[None, :], axis=1)
-        dists.append(dd.min())
-    return float(np.median(dists)) if dists else 0.0
