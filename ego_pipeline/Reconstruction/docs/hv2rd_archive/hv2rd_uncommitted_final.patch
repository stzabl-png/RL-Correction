-    x1 = source_pts - mu1[None]
-    x2 = target_pts - mu2[None]
-
-    k = x1.T @ x2
-    U, _, V = torch.svd(k)
-
-    Z = torch.eye(3, device=U.device)
-    Z[2, 2] = torch.sign(torch.linalg.det(U @ V.T))
-
-    R = V @ Z @ U.T
