-class RigRotationOnlyRetractor(BaseRetractor):
-    def oplus(self, x: SE3, inds: torch.Tensor, dx: torch.Tensor) -> None:
-        dx = dx.clone()
-        dx[:, :3] = 0  # zero out translation part
-        x.data[inds] = SE3(x.data[inds]).retr(dx).data
