-            optimize_intrinsics=self.args.optimize_intrinsics,
-            optimize_rig_rotation=self.args.optimize_rig_rotation,
-            solver_verbose=True,
-        )
-
-    @torch.no_grad()
-    def run(self, steps: int = 12, update_depth: bool = True, log: bool = False):
-        """main update (reset GRU state)"""
