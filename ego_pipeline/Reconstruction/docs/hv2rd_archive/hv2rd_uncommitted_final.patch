-
-    def cpu(self) -> "VideoFrame":
-        def map_cpu(x):
-            return x.cpu() if x is not None else None
-
-        return VideoFrame(
-            raw_frame_idx=self.raw_frame_idx,
-            rgb=self.rgb.cpu(),
-            mask=map_cpu(self.mask),
