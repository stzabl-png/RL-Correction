-        x = coeff * mx
-        y = coeff * my
-        z = coeff * mz
-        self.unprojection_mask = valid_mask & (z > 1e-3)
-
-        xnorm = torch.stack((x, y, z.clamp(1e-3)), dim=1)
-        return xnorm
