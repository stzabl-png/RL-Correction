-inline _CPU_AND_GPU_CODE_ float length(float3 v)
-{
-    return sqrtf(dot(v, v));
-}
-inline _CPU_AND_GPU_CODE_ float length(float4 v)
-{
-    return sqrtf(dot(v, v));
-}
-
-////////////////////////////////////////////////////////////////////////////////
-// normalize
-////////////////////////////////////////////////////////////////////////////////
-
-inline _CPU_AND_GPU_CODE_ float2 normalize(float2 v)
-{
-    float invLen = rsqrtf(dot(v, v));
