-
-class TracksDispRetractor(BaseRetractor):
-    def oplus(self, x: torch.Tensor, inds: torch.Tensor, dx: torch.Tensor) -> None:
-        super().oplus(x, inds, dx)
-        x.clamp_(min=1e-3, max=10)
-
