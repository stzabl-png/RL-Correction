-
-    def cuda(self) -> "VideoFrame":
-        def map_cuda(x):
-            return x.cuda() if x is not None else None
-
-        return VideoFrame(
-            raw_frame_idx=self.raw_frame_idx,
-            rgb=self.rgb.cuda(),
-            mask=map_cuda(self.mask),
