-    for (int c = 0; c < C; c += CHANNEL_STRIDE) {
-        for (int k = 0; k < BLOCK_HW; k += BLOCK_HW / CHANNEL_STRIDE) {
-            int k1 = k + tid / CHANNEL_STRIDE;
