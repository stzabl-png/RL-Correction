-        with torch.inference_mode():
-            outputs = self.model(x)
-
-        pred = outputs["pred_depth"]  # (B, 1, h, w), >= 0
-        pred = F.interpolate(pred, size=(H, W), mode="bilinear", align_corners=True)
-        pred_distance = pred[:, 0]
