-        for stage_idx, take_idx in enumerate(self.intermediate_layer_idx):
-            x = feats[take_idx][:, patch_start_idx:]  # [B*S, N_patch, C]
-            x = self.norm(x)
-            x = x.permute(0, 2, 1).reshape(B, C, ph, pw)  # [B*S, C, ph, pw]
