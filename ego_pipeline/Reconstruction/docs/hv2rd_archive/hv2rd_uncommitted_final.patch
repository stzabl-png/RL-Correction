-class FeatureFusionBlock(nn.Module):
-    """Top-down fusion block: (optional) residual merge + upsampling + 1x1 contraction"""
-
-    def __init__(
-        self,
-        features: int,
-        activation: nn.Module,
-        deconv: bool = False,
-        bn: bool = False,
-        expand: bool = False,
-        align_corners: bool = True,
