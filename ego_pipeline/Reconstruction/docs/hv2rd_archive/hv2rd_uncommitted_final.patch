-            if not (stride == 1 and in_planes == planes):
-                self.norm3 = nn.BatchNorm2d(planes)
-
-        elif norm_fn == "instance":
-            self.norm1 = nn.InstanceNorm2d(planes)
-            self.norm2 = nn.InstanceNorm2d(planes)
-            if not (stride == 1 and in_planes == planes):
-                self.norm3 = nn.InstanceNorm2d(planes)
