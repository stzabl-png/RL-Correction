-def _umeyama_sim3_from_paths(pose_ref, pose_est):
-    ref_points = pose_ref[:, :3, 3]
-    est_points = pose_est[:, :3, 3]
-    r, t, s = _umeyama_points(est_points, ref_points)
-    pose_est_aligned = _apply_sim3_to_poses(pose_est, r, t, s)
