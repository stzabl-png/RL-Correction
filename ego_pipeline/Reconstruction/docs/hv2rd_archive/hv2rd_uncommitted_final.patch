-                t1=t1 if not fixed_motion else t0,
-                n_iters=itrs,
-                pose_damping=1e-3,
-                pose_ep=0.1,
-                motion_only=motion_only,
-                limited_disp=limited_disp,
-                optimize_intrinsics=False,
-                optimize_rig_rotation=False,
-                verbose=False,
