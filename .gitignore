# ---- 训练/运行产物 ----
logs/
results/
wandb/
outputs/
runs/
__pycache__/
*.egg-info/
.hydra/
*.pyc

# ---- 数据 (体积大, 由上游流水线生成, 不入库) ----
# TrainingData: stage_training_data.py 从 OCIR/Bi-V2AP 归置的四类源数据 (~100MB+)
TrainingData/
# data/: 消融曲线 npz、ocir 缓存等生成物
data/
# 物体 USD / retarget 缓存 (由 mesh 自动转换生成)
**/cache/object.usd
**/cache/human_fq_*.npz

# ---- 派生资产 (由 tools/ 脚本从 MagicSim 共享资产生成, 25MB 二进制, 不入库) ----
#   python tools/make_fixed_torso_usd.py   # 躯干/底盘/头 -> fixed joint
#   python tools/add_arm_collision.py      # 补手臂碰撞几何 (必须在上一条之后跑)
assets/*.usd

# ---- 查看器运行时状态 ----
.env_viewer.json
.env_viewer.log

# ---- 媒体产物 ----
videos_compare/
*.mp4
*.avi

# ---- 杂项 ----
.DS_Store
*.swp
.vscode/
.idea/

# ---- 旧 SharpaWave 手内旋转栈的产物 (与 RL_Correction 无关, 本地保留但不入库) ----
checkpoints/
cache/
media/
*.pth

# ---- 本机 Claude Code 配置 ----
.claude/settings.local.json
