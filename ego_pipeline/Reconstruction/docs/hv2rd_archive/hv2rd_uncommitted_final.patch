-__global__ void altcorr_index_forward_kernel(
-    const torch::PackedTensorAccessor32<scalar_t, 5, torch::RestrictPtrTraits> fmap1,
-    const torch::PackedTensorAccessor32<scalar_t, 5, torch::RestrictPtrTraits> fmap2,
