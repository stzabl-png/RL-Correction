-        J[..., 1, 1] = 1
-        J[..., 0, 2] = -uv[..., 0]
-        J[..., 1, 2] = -uv[..., 1]
-        return J
-
-    else:
-        raise ValueError(f"Unknown wrt: {wrt}")
