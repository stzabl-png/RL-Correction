-def _apply_sim3_to_poses(poses, r, t, s):
-    out = poses.copy()
-    Ri = poses[:, :3, :3]
-    ti = poses[:, :3, 3]
-    out[:, :3, :3] = r @ Ri
-    out[:, :3, 3] = (r @ (s * ti.T)).T + t
-    return out
