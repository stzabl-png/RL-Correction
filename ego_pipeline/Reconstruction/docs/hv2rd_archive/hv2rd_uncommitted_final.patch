-    def _crop_ixt(
-        self,
-        intrinsic: np.ndarray | None,
-        orig_w: int,
-        orig_h: int,
-        w: int,
-        h: int,
-    ) -> np.ndarray | None:
-        if intrinsic is None:
-            return None
-        K = intrinsic.copy()
-        crop_h = (orig_h - h) // 2
-        crop_w = (orig_w - w) // 2
-        K[0, 2] -= crop_w
-        K[1, 2] -= crop_h
-        return K
