-            Jf = coords.new_zeros(coords.shape + (1 + 1,))
-            Jf[..., 0, 0] = X * d
-            Jf[..., 1, 0] = Y * d
-            Jf[..., 0, 1] = -fx * r * X * d**2
-            Jf[..., 1, 1] = -fy * r * Y * d**2
-
-        return coords, Jp, Jf
